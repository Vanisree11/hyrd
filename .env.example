# ---- Server ----
PORT=8787
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed browser origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/hyrd.db
UPLOAD_DIR=./uploads
# Encrypts stored connector credentials (32+ chars)
CREDENTIAL_KEY=change-me-too-32-characters-minimum

# ---- AI (optional; without a key HYRD uses its deterministic engine) ----
AI_PROVIDER=gemini        # gemini | groq | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Job sources ----
# Adzuna official Jobs API (required for Adzuna India listings; obtain app_id/app_key from developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Optional override for an Adzuna-compatible API host; normally leave blank.
ADZUNA_API_URL=https://api.adzuna.com/v1/api/jobs
# Company career boards via official public JSON APIs (Greenhouse / Lever)
GREENHOUSE_BOARDS=stripe,airbnb,databricks,cloudflare
LEVER_COMPANIES=netflix,palantir
# Demo mode adds a clearly-labelled mock source + mock submission connector
DEMO_MODE=false

# ---- Browser automation (Playwright) ----
ENABLE_BROWSER=false
BROWSER_HEADLESS=true

# ---- Client (Vite) ----
# Set on Vercel; leave empty locally (Vite proxy is used)
VITE_API_URL=
